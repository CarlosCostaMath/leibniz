---
layout: null
permalink: /search.json
---
[
{%- assign posts = site.posts | sort: 'date' | reverse -%}
{%- for post in posts -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": "{{ post.date | date_to_xmlschema }}",
    "categories": [
      {%- for category in post.categories -%}
        {{ category | jsonify }}{%- unless forloop.last -%}, {% endunless %}
      {%- endfor -%}
    ],
    "tags": [
      {%- for tag in post.tags -%}
        {{ tag | jsonify }}{%- unless forloop.last -%}, {% endunless %}
      {%- endfor -%}
    ],
    "excerpt": {{ post.excerpt | default: post.description | default: post.content | strip_html | truncatewords: 40 | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
